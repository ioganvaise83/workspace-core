# Identity infrastructure environment template.
#
# Copy to `.env` in this directory and fill in real values:
#     Copy-Item env.example .env
#
# Syntax is Docker Compose dotenv: KEY=VALUE, one per line. A `KEY: VALUE` line is
# not an assignment — Compose ignores it silently, which is how a deployment ends
# up running with defaults nobody chose. deploy/tests/check-env-templates.sh
# enforces this file's shape.
#
# `.env` is git-ignored. Never commit a filled copy.
#
# Generate every password with a real generator, never by hand:
#     openssl rand -base64 32
# Keycloak evaluates `$` in plain KC_ variables; the KCRAW_ ones below tolerate it.

# --- Database ---------------------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# REQUIRED. 32+ random bytes, base64.
KC_DB_PASSWORD=""

# --- Public identity --------------------------------------------------------
# The exact origin browsers AND containers use to reach Keycloak. It becomes the
# OIDC issuer (`iss`) and must match byte for byte in every consumer.
#
# LOCAL TEST (default): keycloak.local must resolve to 127.0.0.1 on the Windows
# host (hosts file) and to the keycloak container inside Docker (network alias).
# Both sides therefore see ONE origin, which is what makes the issuer consistent.
#
# CORPORATE (later): https://id.corp.example, behind the corporate edge.
KC_HOSTNAME=https://keycloak.local:8443

# --- TLS for the browser-facing listener ------------------------------------
# Directory ON THE HOST holding fullchain.pem and privkey.pem for KC_HOSTNAME.
# Generated by deploy/single-user/scripts/new-local-ca.ps1 (or an equivalent).
# Outside Git, mounted read-only.
KC_TLS_DIR=./tls

# Ports. HTTPS is the browser-facing one; HTTP stays on an internal port for the
# container healthcheck and kcadm.sh and is never published.
KC_HTTPS_PORT=8443
KC_HTTP_INTERNAL_PORT=8080
KC_BIND_ADDRESS=127.0.0.1
KC_LOCAL_PORT=8443

# --- OIDC client (consumed by the realm import) -----------------------------
# The realm template references these values; Keycloak substitutes them from its
# own environment while importing. They are read only on the FIRST start, because
# the import strategy below skips an existing realm.
#
# REQUIRED. The confidential client's secret. The SAME value must end up in
# deploy/single-user/secrets/oidc-client-secret.
OIDC_CLIENT_SECRET=""

# Must match the browser-facing callback exactly, on the host nginx serves.
OIDC_REDIRECT_URI=https://dsh.local/oauth2/callback

# Where Keycloak may send the browser after logout.
OIDC_POST_LOGOUT_REDIRECT_URI=https://dsh.local/

# --- Realm import strategy --------------------------------------------------
# IGNORE_EXISTING is not optional for a live installation. Keycloak runs the
# directory import on every start and its default, OVERWRITE_EXISTING, DELETES
# the existing realm — users, MFA enrolments and the client secret — before
# re-importing. Verified in Keycloak 26.8.2 source. Only set OVERWRITE_EXISTING
# for a throwaway realm you are willing to destroy.
KC_IMPORT_STRATEGY=IGNORE_EXISTING

# --- First administrator -----------------------------------------------------
# Read only while no admin exists. Remove both lines after the first login.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
# REQUIRED. 20+ random characters, not reused anywhere else.
KC_BOOTSTRAP_ADMIN_PASSWORD=""

# --- Operation --------------------------------------------------------------
KC_LOG_LEVEL=INFO
# Addresses allowed to supply X-Forwarded-* headers. Narrow to the concrete edge
# network once the deployment is stable.
KC_PROXY_TRUSTED_ADDRESSES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Named resources --------------------------------------------------------
# Shared with deploy/single-user; created once with `docker network create`.
EDGE_NETWORK=personal-ai-edge
IDENTITY_NETWORK=personal-ai-identity-internal
KC_DB_VOLUME=personal-ai-keycloak-db
