# Identity infrastructure environment template.
#
# Copy to `.env` in this directory and fill in real values:
#     cp env.example .env && chmod 600 .env
#
# `.env` is git-ignored by the repository root rules (`.env` and `.env.*` are
# ignored, `.env.example` is allowed). Never commit a filled copy.
#
# Generate every password with a real generator, never by hand:
#     openssl rand -base64 32
# Avoid the `$` character in generated values used with plain KC_ variables;
# the KCRAW_ variables below tolerate it. If in doubt, regenerate.

# --- Database ---------------------------------------------------------------
KC_DB_NAME: keycloak
KC_DB_USER: keycloak
# REQUIRED. 32+ random bytes, base64. Example generator: openssl rand -base64 32
KC_DB_PASSWORD: ""

# --- Public identity --------------------------------------------------------
# The exact URL browsers and oauth2-proxy use to reach Keycloak. It becomes the
# OIDC issuer (`iss`) and must match byte for byte in every consumer, including
# the trailing-slash policy: use the form WITHOUT a trailing slash.
#
# Lab, reached through an SSH tunnel:
#     KC_HOSTNAME: http://127.0.0.1:8443
# Corporate deployment behind TLS termination:
#     KC_HOSTNAME: https://id.corp.example
KC_HOSTNAME: http://127.0.0.1:8443

# --- OIDC client (consumed by the realm import) -----------------------------
# The realm template config/dsh-single-user-realm.json references these three
# values, and Keycloak substitutes them from its own environment at import time.
# They are read ONLY on the first start, while the realm does not exist yet.
#
# REQUIRED. The confidential client's secret. Generate one and keep it:
#     openssl rand -base64 32
# The SAME value must end up in deploy/single-user/secrets/oidc-client-secret.
# If the realm is later recreated, this changes and must be updated there too.
OIDC_CLIENT_SECRET: ""

# Must match the browser-facing callback exactly, on the host nginx serves.
OIDC_REDIRECT_URI: https://dsh.corp.example/oauth2/callback

# Where Keycloak may send the browser after logout.
OIDC_POST_LOGOUT_REDIRECT_URI: https://dsh.corp.example/

# --- First administrator -----------------------------------------------------
# Used only on the very first start, while no admin exists yet.
# Remove both lines from .env after the first successful login.
KC_BOOTSTRAP_ADMIN_USERNAME: kc-admin
# REQUIRED. 20+ random characters. Not the same as any other password here.
KC_BOOTSTRAP_ADMIN_PASSWORD: ""

# --- Listener ---------------------------------------------------------------
# Loopback by default: the lab is reached through an SSH tunnel. Binding a
# network address is an ACTIVATION decision and requires TLS in front.
KC_BIND_ADDRESS: 127.0.0.1
KC_LOCAL_PORT: "8443"

# --- Operation --------------------------------------------------------------
KC_LOG_LEVEL: INFO
# Addresses allowed to supply X-Forwarded-* headers. Narrow this to the concrete
# edge network once the gateway project exists; the default covers RFC1918 only.
KC_PROXY_TRUSTED_ADDRESSES: 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Named resources --------------------------------------------------------
# Set these if the VM already uses the defaults for another project.
IDENTITY_NETWORK: personal-ai-identity-internal
KC_DB_VOLUME: personal-ai-keycloak-db
