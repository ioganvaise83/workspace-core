# Environment template for the secure single-user deployment.
#
# Copy to `.env` in this directory and fill in real values:
#     cp env.example .env && chmod 600 .env
#
# `.env` is git-ignored by the repository root rules. Never commit a filled copy.
#
# Secrets are NOT here. They live in $SECRETS_DIR as files, generated by
# ./scripts/prepare-secrets.sh. This file holds only non-secret configuration.
#
# Placeholder hostnames (`*.corp.example`) are deliberately fake. Replace them
# with the real corporate names once DNS and certificates exist.

# --- Public identity --------------------------------------------------------
# The hostname browsers use. It must match the certificate's subject alternative
# names and the Keycloak client redirect URI, exactly.
DSH_HOSTNAME: dsh.corp.example

# The OIDC issuer of the identity provider.
#
# If the company already runs a Keycloak (or any OIDC IdP), point this at it and
# do NOT deploy deploy/identity. The local Keycloak is a lab fallback only.
#
#   Corporate Keycloak:  https://id.corp.example/realms/<realm>
#   Lab Keycloak:        http://127.0.0.1:8443/realms/personal-ai
OIDC_ISSUER_URL: https://id.corp.example/realms/personal-ai

# --- Admission (deny by default) -------------------------------------------
# The single admitted subject: the OIDC `sub` claim, NOT the email and NOT the
# username (ADR-4). One value only — phase 1 is single-user by design (ADR-8).
#
# Obtain it once the user exists in Keycloak:
#   docker compose -f deploy/identity/compose.yaml exec keycloak \
#     /opt/keycloak/bin/kcadm.sh get users -r personal-ai -q username=<name> --fields id
GATEWAY_ALLOWED_SUBJECTS: ""

# The authorities the gateway will mint a cookie for. Must contain DSH_HOSTNAME
# verbatim; add `host:port` as a separate entry if the site is served on an
# explicit non-default port.
GATEWAY_ALLOWED_AUTHORITIES: "dsh.corp.example"

# --- Network binding --------------------------------------------------------
# The address nginx listens on. Loopback keeps the deployment off the network:
# use it while validating, then switch to the VM's concrete IP at activation.
# NEVER 0.0.0.0: DSH executes code, and a wildcard bind is forbidden by design.
NGINX_BIND_ADDRESS: 127.0.0.1

NGINX_HTTPS_PORT: "443"
NGINX_CLIENT_MAX_BODY: 300m

# HSTS. Leave empty until HTTPS and the hostname are confirmed working in a
# browser; an early HSTS header pins clients to a broken setup.
# Enable later with: max-age=31536000; includeSubDomains
DSH_HSTS_DIRECTIVE: ""

# --- TLS --------------------------------------------------------------------
# Directory on the host holding fullchain.pem and privkey.pem. Outside Git.
TLS_DIR: /etc/pki/dsh

# --- Internal wiring --------------------------------------------------------
# Container-network addresses; only change them if you rename services.
OAUTH2_PROXY_UPSTREAM: oauth2-proxy:4180
DSH_GATEWAY_UPSTREAM: gateway:8080

# The Harness the gateway forwards to. This is the existing compose service,
# reached over the application network.
DSH_UPSTREAM: http://harness:3080

# The Docker network the existing Harness project already uses. Check the real
# name before activating:
#   docker network ls | grep personal-ai
APP_NETWORK: personal-ai-workspace_default

# Network for the browser-facing leg (nginx, oauth2-proxy, gateway).
EDGE_NETWORK: personal-ai-edge

# --- Secrets and lifetime ---------------------------------------------------
# Directory holding the four secret files, created by ./scripts/prepare-secrets.sh.
# Must be 0700 and outside Git.
SECRETS_DIR: ./secrets

# Allowlist file mounted into oauth2-proxy. The tracked copy has no active entry;
# point this at your real file (for example ./secrets/allowed-subjects.txt).
ALLOWED_SUBJECTS_FILE: ./oauth2-proxy/allowed-subjects.txt

# Lifetime of the DSH browser cookie, in seconds. Must not exceed the DSH
# `cookieMaxAgeDays` set in the profile override (86400 = 1 day, the recommended
# phase-1 value per ADR-5). Keeping them equal avoids a confusing mismatch where
# the gateway mints a cookie DSH immediately rejects.
GATEWAY_COOKIE_MAX_AGE_SECONDS: "86400"
